rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/workspaces/main {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function valid() {
        return request.resource.data.keys().hasOnly(['payload', 'revision', 'writer', 'updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() <= 850000
          && request.resource.data.revision is int
          && request.resource.data.writer is string
          && request.resource.data.writer.size() <= 100
          && request.resource.data.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if owner();
    }
  }
}
